# Local development example
# Replace host/user/password/dbname with the values of your MySQL instance
# and keep SSL enabled. Prefer verify-full with the AWS RDS CA in production.
DATABASE_URL=
JWT_SECRET=
# Segredo compartilhado com a Iniciadora (header x-initiator-key) para os
# endpoints ITP/PISP JSR.
INITIATOR_SERVICE_SECRET=
# Origens para as quais o core pode disparar webhook de consentimento,
# separadas por virgula (ex.: http://localhost:8100). Vazio = nenhum webhook
# sai, e a Iniciadora so descobre o desfecho pelo GET do consentimento.
WEBHOOK_ALLOWED_ORIGINS=
#HOST=0.0.0.0
#PORT=3000

NODE_ENV="development"

PORT=3000
