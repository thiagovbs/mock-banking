# Local development example
# For AWS RDS on Render, replace host/user/password/dbname with the RDS values
# and keep SSL enabled. Prefer verify-full with the AWS RDS CA in production.
DATABASE_URL="postgresql://admin:REDACTED-senha-db@REDACTED-host-rds:3306/banking?schema=public"
JWT_SECRET="REDACTED-jwt-secret"
# Segredo compartilhado com a Iniciadora (header x-initiator-key) para os
# endpoints ITP/PISP JSR.
INITIATOR_SERVICE_SECRET="<INITIATOR_SERVICE_SECRET>"
#HOST=0.0.0.0
# Render injects PORT automatically. Keep this only for local execution.
#PORT=3000

NODE_ENV="development"

PORT=3000
