# Local development example
# Replace host/user/password/dbname with the values of your MySQL instance
# and keep SSL enabled. Prefer verify-full with the AWS RDS CA in production.
DATABASE_URL=
JWT_SECRET=
# Segredo compartilhado com a Iniciadora (header x-initiator-key) para os
# endpoints ITP/PISP JSR.
INITIATOR_SERVICE_SECRET=
# Origens para as quais o core pode disparar webhook de consentimento,
# separadas por virgula (ex.: http://localhost:8100). Vazio = nenhum webhook
# sai, e a Iniciadora so descobre o desfecho pelo GET do consentimento.
WEBHOOK_ALLOWED_ORIGINS=
# Endereco publico sob o qual esta API e alcancada, COM o basePath do gateway
# (ex.: https://api-assets.sensedia.com/v1). Atras de um gateway o Host da
# requisicao e o do backend, entao sem isto a URL de aprovacao devolvida a
# Iniciadora aponta para o endereco interno e os formularios das telas HTML
# postam num caminho sem o basePath. Vazio = usa o host da requisicao, que e o
# certo em acesso direto e em desenvolvimento.
PUBLIC_BASE_URL=
#HOST=0.0.0.0
#PORT=3000

NODE_ENV="development"

PORT=3000
