generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  BLOCKED
  CLOSED
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum PaymentStatus {
  COMPLETED
  FAILED
}

enum PixReceiptStatus {
  COMPLETED
  FAILED
}

enum PixKeyType {
  CPF
  CNPJ
  EMAIL
  PHONE
  EVP
}

enum PixKeyStatus {
  ACTIVE
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  customer     Customer?
}

model Customer {
  id        String    @id @default(uuid())
  userId    String    @unique
  name      String
  document  String    @unique
  email     String    @unique
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts  Account[]
}

model Account {
  id                   String        @id @default(uuid())
  customerId           String
  branch               String        @default("0001")
  accountNumber        String        @unique
  balance              Decimal       @default(0) @db.Decimal(15, 2)
  status               AccountStatus @default(ACTIVE)
  createdAt            DateTime      @default(now())
  customer             Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  transactions         Transaction[]
  payments             Payment[]
  pixReceipts          PixReceipt[]
  pixKeys              PixKey[]
  pixTransfersSent     PixTransfer[] @relation("PixTransferSource")
  pixTransfersReceived PixTransfer[] @relation("PixTransferDestination")
}

model Transaction {
  id            String          @id @default(uuid())
  accountId     String
  type          TransactionType
  amount        Decimal         @db.Decimal(15, 2)
  balanceBefore Decimal         @db.Decimal(15, 2)
  balanceAfter  Decimal         @db.Decimal(15, 2)
  referenceId   String?
  description   String?
  createdAt     DateTime        @default(now())
  account       Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
}

model Payment {
  id              String        @id @default(uuid())
  accountId       String
  amount          Decimal       @db.Decimal(15, 2)
  beneficiaryName String
  beneficiaryDoc  String
  description     String?
  status          PaymentStatus
  idempotencyKey  String
  transactionId   String?       @unique
  createdAt       DateTime      @default(now())
  account         Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, idempotencyKey])
  @@index([accountId, createdAt])
}

model PixReceipt {
  id            String           @id @default(uuid())
  accountId     String
  pixKeyId      String?
  endToEndId    String           @unique
  consentId     String?          @unique @db.VarChar(255)
  enrollmentId  String?          @db.VarChar(255)
  amount        Decimal          @db.Decimal(15, 2)
  description   String?
  status        PixReceiptStatus @default(COMPLETED)
  transactionId String           @unique
  createdAt     DateTime         @default(now())
  account       Account          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  pixKey        PixKey?          @relation(fields: [pixKeyId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([pixKeyId, createdAt])
}

model PixKey {
  id           String        @id @default(uuid())
  accountId    String
  type         PixKeyType
  value        String        @unique @db.VarChar(255)
  status       PixKeyStatus  @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  pixReceipts  PixReceipt[]
  pixTransfers PixTransfer[]

  @@index([accountId, createdAt])
}

model PixTransfer {
  id                   String           @id @default(uuid())
  sourceAccountId      String
  destinationAccountId String
  pixKeyId             String
  endToEndId           String           @unique
  consentId            String           @unique @db.VarChar(255)
  enrollmentId         String?          @db.VarChar(255)
  amount               Decimal          @db.Decimal(15, 2)
  description          String?
  status               PixReceiptStatus @default(COMPLETED)
  debitTransactionId   String           @unique
  creditTransactionId  String           @unique
  createdAt            DateTime         @default(now())

  sourceAccount      Account @relation("PixTransferSource", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount Account @relation("PixTransferDestination", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  pixKey             PixKey  @relation(fields: [pixKeyId], references: [id], onDelete: Restrict)

  @@index([sourceAccountId, createdAt])
  @@index([destinationAccountId, createdAt])
  @@index([pixKeyId, createdAt])
}
