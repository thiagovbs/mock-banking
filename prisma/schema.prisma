generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  BLOCKED
  CLOSED
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum PaymentStatus {
  COMPLETED
  FAILED
}

// Mantido apos a remocao de PixReceipt: PixTransfer.status ainda o utiliza.
enum PixReceiptStatus {
  COMPLETED
  FAILED
}

enum PaymentMethod {
  PIX
  QR_CODE
  BOLETO
  BILL
}

enum PixKeyType {
  CPF
  CNPJ
  EMAIL
  PHONE
  EVP
}

enum PixKeyStatus {
  ACTIVE
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  customer     Customer?
}

model AuthRequest {
  id          String   @id @default(uuid())
  redirectUri String
  userId      String?
  code        String?  @unique
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Customer {
  id        String    @id @default(uuid())
  userId    String    @unique
  name      String
  document  String    @unique
  email     String    @unique
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts  Account[]
}

model Account {
  id                   String        @id @default(uuid())
  customerId           String
  branch               String        @default("0001")
  accountNumber        String        @unique
  balance              Decimal       @default(0) @db.Decimal(15, 2)
  status               AccountStatus @default(ACTIVE)
  createdAt            DateTime      @default(now())
  customer             Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  transactions         Transaction[]
  payments             Payment[]
  pixKeys              PixKey[]
  pixTransfersSent     PixTransfer[] @relation("PixTransferSource")
  pixTransfersReceived PixTransfer[] @relation("PixTransferDestination")
  paymentConsents      PaymentConsent[]
  paymentRequests      PaymentRequest[]
  enrollments          Enrollment[]
}

model Transaction {
  id            String          @id @default(uuid())
  accountId     String
  type          TransactionType
  amount        Decimal         @db.Decimal(15, 2)
  balanceBefore Decimal         @db.Decimal(15, 2)
  balanceAfter  Decimal         @db.Decimal(15, 2)
  referenceId   String?
  description   String?
  createdAt     DateTime        @default(now())
  account       Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
}

model Payment {
  id              String        @id @default(uuid())
  accountId       String
  method          PaymentMethod
  amount          Decimal       @db.Decimal(15, 2)
  description     String?
  status          PaymentStatus
  idempotencyKey  String
  transactionId   String?       @unique

  // Beneficiario: a fachada atual nao coleta esses dados, mas o registro
  // antigo os tinha e um pagamento de boleto/conta pode voltar a preenche-los.
  beneficiaryName String?
  beneficiaryDoc  String?

  // PIX e QR_CODE
  pixKey          String?       @db.VarChar(255)
  endToEndId      String?       @db.VarChar(255)
  pixTransferId   String?       @unique

  // BOLETO
  digitableLine   String?       @db.VarChar(100)

  // BILL
  billProvider    String?       @db.VarChar(100)
  billReference   String?       @db.VarChar(255)

  createdAt       DateTime      @default(now())
  account         Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, idempotencyKey])
  @@index([accountId, createdAt])
}

model PixKey {
  id           String        @id @default(uuid())
  accountId    String
  type         PixKeyType
  value        String        @unique @db.VarChar(255)
  status       PixKeyStatus  @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  pixTransfers PixTransfer[]
  paymentRequests PaymentRequest[]

  @@index([accountId, createdAt])
}

model PixTransfer {
  id                   String           @id @default(uuid())
  sourceAccountId      String
  destinationAccountId String
  pixKeyId             String
  endToEndId           String           @unique
  consentId            String           @unique @db.VarChar(255)
  enrollmentId         String?          @db.VarChar(255)
  amount               Decimal          @db.Decimal(15, 2)
  description          String?
  status               PixReceiptStatus @default(COMPLETED)
  debitTransactionId   String           @unique
  creditTransactionId  String           @unique
  createdAt            DateTime         @default(now())

  sourceAccount      Account @relation("PixTransferSource", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount Account @relation("PixTransferDestination", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  pixKey             PixKey  @relation(fields: [pixKeyId], references: [id], onDelete: Restrict)

  @@index([sourceAccountId, createdAt])
  @@index([destinationAccountId, createdAt])
  @@index([pixKeyId, createdAt])
}

enum PaymentConsentStatus {
  CREATED
  AUTHORISED
  PAYMENT_SUBMITTED
  COMPLETED
  EXPIRED
}

model PaymentConsent {
  id                 String               @id @default(uuid())
  externalConsentId  String?              @unique @db.VarChar(255)
  userId             String
  customerId         String
  accountId          String
  amount             Decimal              @db.Decimal(15, 2)
  description        String?
  creditorName       String
  creditorDocument   String?
  creditorKeyType    PixKeyType
  creditorKeyValue   String               @db.VarChar(255)
  status             PaymentConsentStatus @default(CREATED)
  paymentId          String?              @unique
  authorisationFlow  String?
  fidoChallenge      String?
  // Jornada JSR: o consentimento nasce preso a um enrollment, e registra qual
  // credencial de fato o autorizou.
  enrollmentId       String?
  fidoCredentialId   String?
  createdAt          DateTime             @default(now())
  authorisedAt       DateTime?
  submittedAt        DateTime?
  expiredAt          DateTime?

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([accountId, createdAt])
}

enum EnrollmentStatus {
  CREATED
  ACCOUNT_HOLDER_CONFIRMED
  FIDO_REGISTERED
  USED
}

model Enrollment {
  id          String           @id @default(uuid())
  userId      String?
  // Conta fixada no account-holder-confirmed. Todo consentimento JSR deriva
  // dela, em vez de aceitar accountId pelo corpo da requisicao.
  accountId   String?
  status      EnrollmentStatus @default(CREATED)
  requestId   String?          @unique
  code        String?          @unique
  redirectUri String
  challenge   String
  used        Boolean          @default(false)
  // Dispositivo ativo = FIDO_REGISTERED e revokedAt nulo.
  revokedAt   DateTime?
  createdAt   DateTime         @default(now())

  account Account? @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([accountId, createdAt])
}

model FidoCredential {
  id           String   @id @default(uuid())
  userId       String
  enrollmentId String?  @unique
  credentialId String   @unique
  publicKey    String
  counter      Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

enum PaymentRequestStatus {
  ACTIVE
  PAID
  EXPIRED
  CANCELLED
}

model PaymentRequest {
  id          String               @id @default(uuid())
  txid        String               @unique @db.VarChar(255)
  accountId   String
  pixKeyId    String
  amount      Decimal              @db.Decimal(15, 2)
  description String?              @db.VarChar(255)
  payload     String               @db.Text
  status      PaymentRequestStatus @default(ACTIVE)
  expiresAt   DateTime
  paidAt      DateTime?
  createdAt   DateTime             @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  pixKey  PixKey  @relation(fields: [pixKeyId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
}
