generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  BLOCKED
  CLOSED
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum PaymentStatus {
  COMPLETED
  FAILED
}

// Mantido apos a remocao de PixReceipt: PixTransfer.status ainda o utiliza.
enum PixReceiptStatus {
  COMPLETED
  FAILED
}

enum PaymentMethod {
  PIX
  QR_CODE
  BOLETO
  BILL
}

enum PixKeyType {
  CPF
  CNPJ
  EMAIL
  PHONE
  EVP
}

enum PixKeyStatus {
  ACTIVE
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  customer     Customer?
}

model AuthRequest {
  id          String   @id @default(uuid())
  redirectUri String
  userId      String?
  code        String?  @unique
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Customer {
  id        String    @id @default(uuid())
  userId    String    @unique
  name      String
  document  String    @unique
  email     String    @unique
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts  Account[]
}

model Account {
  id                   String        @id @default(uuid())
  customerId           String
  branch               String        @default("0001")
  accountNumber        String        @unique
  balance              Decimal       @default(0) @db.Decimal(15, 2)
  status               AccountStatus @default(ACTIVE)
  createdAt            DateTime      @default(now())
  customer             Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  transactions         Transaction[]
  payments             Payment[]
  pixKeys              PixKey[]
  pixTransfersSent     PixTransfer[] @relation("PixTransferSource")
  pixTransfersReceived PixTransfer[] @relation("PixTransferDestination")
  paymentConsents      PaymentConsent[]
  paymentRequests      PaymentRequest[]
  enrollments          Enrollment[]
  sharedInConsents     DataSharingConsentAccount[]
}

model Transaction {
  id            String          @id @default(uuid())
  accountId     String
  type          TransactionType
  amount        Decimal         @db.Decimal(15, 2)
  balanceBefore Decimal         @db.Decimal(15, 2)
  balanceAfter  Decimal         @db.Decimal(15, 2)
  referenceId   String?
  description   String?
  createdAt     DateTime        @default(now())
  account       Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
}

model Payment {
  id              String        @id @default(uuid())
  accountId       String
  method          PaymentMethod
  amount          Decimal       @db.Decimal(15, 2)
  description     String?
  status          PaymentStatus
  idempotencyKey  String
  transactionId   String?       @unique

  // Beneficiario: a fachada atual nao coleta esses dados, mas o registro
  // antigo os tinha e um pagamento de boleto/conta pode voltar a preenche-los.
  beneficiaryName String?
  beneficiaryDoc  String?

  // PIX e QR_CODE
  pixKey          String?       @db.VarChar(255)
  endToEndId      String?       @db.VarChar(255)
  pixTransferId   String?       @unique

  // BOLETO
  digitableLine   String?       @db.VarChar(100)

  // BILL
  billProvider    String?       @db.VarChar(100)
  billReference   String?       @db.VarChar(255)

  createdAt       DateTime      @default(now())
  account         Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, idempotencyKey])
  @@index([accountId, createdAt])
}

model PixKey {
  id           String        @id @default(uuid())
  accountId    String
  type         PixKeyType
  value        String        @unique @db.VarChar(255)
  status       PixKeyStatus  @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  pixTransfers PixTransfer[]
  paymentRequests PaymentRequest[]

  @@index([accountId, createdAt])
}

model PixTransfer {
  id                   String           @id @default(uuid())
  sourceAccountId      String
  destinationAccountId String
  pixKeyId             String
  endToEndId           String           @unique
  consentId            String           @unique @db.VarChar(255)
  enrollmentId         String?          @db.VarChar(255)
  amount               Decimal          @db.Decimal(15, 2)
  description          String?
  status               PixReceiptStatus @default(COMPLETED)
  debitTransactionId   String           @unique
  creditTransactionId  String           @unique
  createdAt            DateTime         @default(now())

  sourceAccount      Account @relation("PixTransferSource", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount Account @relation("PixTransferDestination", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  pixKey             PixKey  @relation(fields: [pixKeyId], references: [id], onDelete: Restrict)

  @@index([sourceAccountId, createdAt])
  @@index([destinationAccountId, createdAt])
  @@index([pixKeyId, createdAt])
}

enum PaymentConsentStatus {
  // Jornada JSR: o consentimento nasce preso a um dispositivo ja aprovado e e
  // autorizado pela assertion FIDO, sem redirecionar o titular.
  CREATED
  // Jornada com redirecionamento: a Iniciadora cria o consentimento sem saber
  // quem e o titular, e ele so vira AUTHORISED depois que a pessoa entra na
  // tela da Detentora, ve valor e credor, escolhe a conta e confirma.
  AWAITING_AUTHORISATION
  AUTHORISED
  REJECTED
  PAYMENT_SUBMITTED
  COMPLETED
  EXPIRED
}

model PaymentConsent {
  id                 String               @id @default(uuid())
  externalConsentId  String?              @unique @db.VarChar(255)
  // Nulos ate a autorizacao na jornada com redirecionamento: quem paga e de
  // qual conta so se sabe quando o titular entra na tela e confirma.
  userId             String?
  customerId         String?
  accountId          String?
  // CPF a quem o consentimento foi enderecado, quando a Iniciadora o informa.
  // Preenchido, so esse titular consegue autorizar.
  debtorDocument     String?              @db.VarChar(191)
  amount             Decimal              @db.Decimal(15, 2)
  description        String?
  creditorName       String
  creditorDocument   String?
  creditorKeyType    PixKeyType
  creditorKeyValue   String               @db.VarChar(255)
  status             PaymentConsentStatus @default(CREATED)
  paymentId          String?              @unique
  authorisationFlow  String?
  fidoChallenge      String?
  // Jornada JSR: o consentimento nasce preso a um enrollment, e registra qual
  // credencial de fato o autorizou.
  enrollmentId       String?
  fidoCredentialId   String?
  // Para onde devolver o navegador do titular ao fim da tela de autorizacao.
  redirectUri        String?              @db.VarChar(500)
  createdAt          DateTime             @default(now())
  statusUpdatedAt    DateTime             @default(now())
  authorisedAt       DateTime?
  rejectedAt         DateTime?
  submittedAt        DateTime?
  expiredAt          DateTime?

  // Para onde avisar a Iniciadora quando o status mudar. Sem isso ela so
  // descobre o desfecho se o navegador do titular voltar.
  webhookUri         String?              @db.VarChar(500)

  account Account?              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  events  PaymentConsentEvent[]

  @@index([userId, createdAt])
  @@index([accountId, createdAt])
  @@index([debtorDocument, createdAt])
}

enum PaymentConsentEventActor {
  INITIATOR
  HOLDER
  SYSTEM
}

enum PaymentConsentEventOutcome {
  ACCEPTED
  REFUSED
}

// Trilha de auditoria do consentimento de pagamento.
//
// O consentimento carrega o estado atual; esta tabela carrega o caminho ate
// ele -- inclusive o que foi *tentado e recusado*, que nao deixa marca nenhuma
// no consentimento. E o que responde "quem autorizou, quando, e o que a
// Iniciadora tentou fazer antes disso".
model PaymentConsentEvent {
  id           String                     @id @default(uuid())
  consentId    String
  event        String                     @db.VarChar(60)
  actor        PaymentConsentEventActor
  actorUserId  String?
  outcome      PaymentConsentEventOutcome @default(ACCEPTED)
  // Codigo do AppError quando REFUSED (CONSENT_NOT_AUTHORISED, etc).
  reason       String?                    @db.VarChar(60)
  statusBefore PaymentConsentStatus?
  statusAfter  PaymentConsentStatus?
  detail       Json?
  createdAt    DateTime                   @default(now())

  consent PaymentConsent @relation(fields: [consentId], references: [id], onDelete: Cascade)

  @@index([consentId, createdAt])
}

enum EnrollmentStatus {
  CREATED
  ACCOUNT_HOLDER_CONFIRMED
  FIDO_REGISTERED
  USED
}

model Enrollment {
  id          String           @id @default(uuid())
  userId      String?
  // Conta fixada no account-holder-confirmed. Todo consentimento JSR deriva
  // dela, em vez de aceitar accountId pelo corpo da requisicao.
  accountId   String?
  status      EnrollmentStatus @default(CREATED)
  requestId   String?          @unique
  code        String?          @unique
  redirectUri String
  challenge   String
  used        Boolean          @default(false)
  // Dispositivo ativo = FIDO_REGISTERED e revokedAt nulo.
  revokedAt   DateTime?
  createdAt   DateTime         @default(now())

  account Account? @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([accountId, createdAt])
}

model FidoCredential {
  id           String   @id @default(uuid())
  userId       String
  enrollmentId String?  @unique
  credentialId String   @unique
  publicKey    String
  counter      Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

enum PaymentRequestStatus {
  ACTIVE
  PAID
  EXPIRED
  CANCELLED
}

model PaymentRequest {
  id          String               @id @default(uuid())
  txid        String               @unique @db.VarChar(255)
  accountId   String
  pixKeyId    String
  amount      Decimal              @db.Decimal(15, 2)
  description String?              @db.VarChar(255)
  payload     String               @db.Text
  status      PaymentRequestStatus @default(ACTIVE)
  expiresAt   DateTime
  paidAt      DateTime?
  createdAt   DateTime             @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  pixKey  PixKey  @relation(fields: [pixKeyId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
}

// ---------------------------------------------------------------------------
// Compartilhamento de dados (jornada AISP do Open Finance)
//
// Uma conta (receptora) pede ao titular de outra conta permissao para ler
// saldo e extrato. O titular autoriza escolhendo quais das suas contas entram
// no consentimento. Os status seguem o padrao OFB: nao existe REVOKED nem
// EXPIRED -- ambos sao REJECTED com um motivo, o que mantem uma unica maquina
// de estados.
// ---------------------------------------------------------------------------

enum DataSharingConsentStatus {
  AWAITING_AUTHORISATION
  AUTHORISED
  REJECTED
}

enum DataSharingRejectedBy {
  USER
  ASPSP
  TPP
}

enum DataSharingRejectReason {
  CUSTOMER_MANUALLY_REJECTED
  CUSTOMER_MANUALLY_REVOKED
  CONSENT_EXPIRED
}

model DataSharingConsent {
  id                String                    @id @default(uuid())
  // Receptora: quem passa a enxergar os dados.
  granteeUserId     String
  granteeCustomerId String
  // Titular dos dados. Na criacao a receptora so informa o documento
  // (loggedUser.document.identification); o vinculo com o usuario real so e
  // fixado quando ele autoriza.
  granterDocument   String                    @db.VarChar(191)
  granterUserId     String?
  granterCustomerId String?
  permissions       Json
  // Para onde devolver o navegador depois da tela de consentimento. Fecha o
  // loop da jornada por redirect, como o redirectUri do AuthRequest faz no
  // login. Nulo = a tela termina em uma pagina de conclusao.
  redirectUri       String?                   @db.VarChar(500)
  status            DataSharingConsentStatus  @default(AWAITING_AUTHORISATION)
  // Nulo = prazo indeterminado.
  expiresAt         DateTime?
  rejectedBy        DataSharingRejectedBy?
  rejectReason      DataSharingRejectReason?
  createdAt         DateTime                  @default(now())
  statusUpdatedAt   DateTime                  @default(now())
  authorisedAt      DateTime?
  rejectedAt        DateTime?

  accounts DataSharingConsentAccount[]
  accesses DataSharingAccess[]

  @@index([granteeCustomerId, createdAt])
  @@index([granterUserId, createdAt])
  @@index([granterDocument, createdAt])
}

model DataSharingConsentAccount {
  id        String   @id @default(uuid())
  consentId String
  accountId String
  createdAt DateTime @default(now())

  consent DataSharingConsent @relation(fields: [consentId], references: [id], onDelete: Cascade)
  account Account            @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([consentId, accountId])
  @@index([accountId])
}

// Trilha de acesso: cada leitura feita pela receptora sob um consentimento.
model DataSharingAccess {
  id        String   @id @default(uuid())
  consentId String
  accountId String?
  resource  String   @db.VarChar(60)
  createdAt DateTime @default(now())

  consent DataSharingConsent @relation(fields: [consentId], references: [id], onDelete: Cascade)

  @@index([consentId, createdAt])
}
